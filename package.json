{
  "name": "monique-reid-bookkeeping",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-sitemap.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:functions": "tsc --noEmit -p functions/tsconfig.json",
    "lint:lead-retention-worker": "tsc --noEmit -p workers/lead-retention-purge/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/node": "^22.14.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
