# Local development values. Real values live in Cloudflare Pages (Settings -> Environment variables)
# and GitHub (Settings -> Secrets and variables -> Actions). Never commit real keys.

# Used by the Pages Functions in /functions (server side only)
GEMINI_API_KEY=""
RESEND_API_KEY=""
GOOGLE_SA_KEY=""
SPREADSHEET_ID=""

# Optional bot check (Cloudflare Turnstile).
# VITE_TURNSTILE_SITE_KEY is public and is read at build time.
# TURNSTILE_SECRET_KEY is private; set it only AFTER the site key is live.
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
